# ─── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/advanced_quiz

# ─── Better Auth ───────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=your-secret-key-min-32-characters-long-here
BETTER_AUTH_URL=http://localhost:3001

# ─── URLs ──────────────────────────────────────────────────────────────────
API_URL=http://localhost:3001
WEB_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ─── Email (Resend) ────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=auth@example.com

# ─── API Server ────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Vite (prefix with VITE_ for client exposure) ─────────────────────────
VITE_API_URL=http://localhost:3001

# ─── Swagger ───────────────────────────────────────────────────────────────
# ENABLE_DOCS=true   # Uncomment to enable docs in production
