{
  "name": "@advanced-quiz/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run dist/index.js",
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:migrate-auth": "bun run src/scripts/migrate-auth.ts"
  },
  "dependencies": {
    "@advanced-quiz/config": "workspace:*",
    "@advanced-quiz/contracts": "workspace:*",
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "better-auth": "^1.2.0",
    "drizzle-orm": "^0.45.1",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.0",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.9",
    "pino-pretty": "^13.1.2",
    "typescript": "^5.9.2"
  }
}
