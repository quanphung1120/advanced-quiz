{
  "name": "@advanced-quiz/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx --bun prisma generate --config prisma.config.ts && bun run --watch src/index.ts",
    "build": "bunx --bun prisma generate --config prisma.config.ts && tsc -p tsconfig.json",
    "start": "bun run dist/src/index.js",
    "check-types": "bunx --bun prisma generate --config prisma.config.ts && tsc --noEmit",
    "db:generate": "bunx --bun prisma generate --config prisma.config.ts",
    "db:migrate": "bunx --bun prisma migrate dev --config prisma.config.ts",
    "db:migrate:deploy": "bunx --bun prisma migrate deploy --config prisma.config.ts",
    "db:push": "bunx --bun prisma db push --config prisma.config.ts",
    "db:studio": "bunx --bun prisma studio --config prisma.config.ts"
  },
  "dependencies": {
    "@advanced-quiz/config": "workspace:*",
    "@advanced-quiz/contracts": "workspace:*",
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "@nestjs/common": "^11.1.16",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.16",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.1.16",
    "@nestjs/swagger": "^11.2.6",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "bcrypt": "^6.0.0",
    "fastify": "^5.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "prisma": "^7.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bun": "^1.3.10",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2"
  }
}
