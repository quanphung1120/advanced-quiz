{
  "name": "@advanced-quiz/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "lint": "eslint .",
    "start": "nest start",
    "check-types": "tsc --noEmit",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "format": "prettier --write . --ignore-unknown --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-unknown --ignore-path ../../.prettierignore"
  },
  "dependencies": {
    "@advanced-quiz/contracts": "workspace:*",
    "@advanced-quiz/db": "workspace:*",
    "@ai-sdk/devtools": "^0.0.15",
    "@ai-sdk/gateway": "^3.0.66",
    "@nestjs/common": "^11.1.16",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.16",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.16",
    "@nestjs/swagger": "^11.2.6",
    "ai": "^6.0.116",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@advanced-quiz/eslint-config": "workspace:*",
    "@advanced-quiz/typescript-config": "workspace:*",
    "@nestjs/cli": "^11.0.14",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^9.39.1",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2"
  }
}
