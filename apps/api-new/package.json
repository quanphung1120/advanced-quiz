{
  "name": "@advanced-quiz/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "([ -d ../../packages/db/generated/prisma ] || bun run --cwd ../../packages/db db:generate) && bun run --watch src/index.ts",
    "build": "([ -d ../../packages/db/generated/prisma ] || bun run --cwd ../../packages/db db:generate) && rm -rf dist && tsc -p tsconfig.json",
    "start": "bun run dist/index.js",
    "check-types": "([ -d ../../packages/db/generated/prisma ] || bun run --cwd ../../packages/db db:generate) && tsc --noEmit",
    "db:generate": "bun run --cwd ../../packages/db db:generate",
    "db:migrate": "bun run --cwd ../../packages/db db:migrate",
    "db:migrate:deploy": "bun run --cwd ../../packages/db db:deploy",
    "db:push": "bun run --cwd ../../packages/db db:push",
    "db:studio": "bun run --cwd ../../packages/db db:studio"
  },
  "dependencies": {
    "@advanced-quiz/db": "workspace:*",
    "@advanced-quiz/config": "workspace:*",
    "@advanced-quiz/contracts": "workspace:*",
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "@nestjs/common": "^11.1.16",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.16",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.1.16",
    "@nestjs/swagger": "^11.2.6",
    "bcrypt": "^6.0.0",
    "fastify": "^5.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bun": "^1.3.10",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2"
  }
}
