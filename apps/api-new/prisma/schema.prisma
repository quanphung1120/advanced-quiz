generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String                   @id @default(uuid())
  name              String
  email             String                   @unique
  password          String
  emailVerified     Boolean                  @default(false) @map("email_verified")
  emailVerifiedAt   DateTime?                @map("email_verified_at")
  passwordChangedAt DateTime?                @map("password_changed_at")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  refreshTokens     RefreshToken[]
  emailOtps         EmailOtp[]
  passwordResets    PasswordResetToken[]
  ownedCollections  Collection[]             @relation("CollectionOwner")
  collaborations    CollectionCollaborator[]
  createdFlashcards Flashcard[]              @relation("FlashcardCreator")
  reviews           FlashcardReview[]

  @@map("user")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_token")
}

model EmailOtp {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  purpose    String
  codeHash   String   @map("code_hash")
  expiresAt  DateTime @map("expires_at")
  lastSentAt DateTime @default(now()) @map("last_sent_at")
  attempts   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("email_otp")
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_token")
}

model Collection {
  id            String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String                   @db.Text
  description   String?                  @db.Text
  isPublic      Boolean                  @default(false) @map("is_public")
  ownerId       String                   @map("owner_id")
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")
  owner         User                     @relation("CollectionOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  collaborators CollectionCollaborator[]
  flashcards    Flashcard[]

  @@index([ownerId], map: "collection_owner_id_idx")
  @@map("collection")
}

model CollectionCollaborator {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collectionId String     @map("collection_id") @db.Uuid
  userId       String     @map("user_id")
  role         String     @default("viewer") @db.Text
  createdAt    DateTime   @default(now()) @map("created_at")
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([collectionId, userId], map: "collection_collaborator_unique_idx")
  @@map("collection_collaborator")
}

model Flashcard {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  question     String            @db.Text
  answer       String            @db.Text
  type         String            @default("simple") @db.Text
  collectionId String            @map("collection_id") @db.Uuid
  createdBy    String            @map("created_by")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  collection   Collection        @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  creator      User              @relation("FlashcardCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  reviews      FlashcardReview[]

  @@index([collectionId], map: "flashcard_collection_id_idx")
  @@map("flashcard")
}

model FlashcardReview {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  flashcardId    String    @map("flashcard_id") @db.Uuid
  userId         String    @map("user_id")
  easeFactor     Float     @default(2.5) @map("ease_factor")
  interval       Int       @default(0)
  dueAt          DateTime  @default(now()) @map("due_at")
  status         String    @default("new") @db.Text
  learningStep   Int       @default(0) @map("learning_step")
  reviewCount    Int       @default(0) @map("review_count")
  lapseCount     Int       @default(0) @map("lapse_count")
  lastReviewedAt DateTime? @map("last_reviewed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  flashcard      Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, flashcardId], map: "flashcard_review_user_card_idx")
  @@index([userId, dueAt], map: "flashcard_review_due_idx")
  @@index([userId, status], map: "flashcard_review_status_idx")
  @@map("flashcard_review")
}
