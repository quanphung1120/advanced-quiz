generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String                   @id @default(uuid()) @db.Text
  name              String                   @db.Text
  email             String                   @unique(map: "user_email_key") @db.Text
  password          String                   @db.Text
  emailVerified     Boolean                  @default(false) @map("email_verified")
  emailVerifiedAt   DateTime?                @map("email_verified_at") @db.Timestamp(3)
  passwordChangedAt DateTime?                @map("password_changed_at") @db.Timestamp(3)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamp(3)
  refreshTokens     RefreshToken[]
  emailOtps         EmailOtp[]
  passwordResets    PasswordResetToken[]
  ownedCollections  Collection[]             @relation("CollectionOwner")
  collaborations    CollectionCollaborator[]
  createdFlashcards Flashcard[]              @relation("FlashcardCreator")
  reviews           FlashcardReview[]
  chatSessions      ChatSession[]

  @@map("user")
}

model ChatSession {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String        @map("user_id") @db.Text
  title     String        @default("New chat") @db.Text
  preview   String?       @db.Text
  messages  Json          @default("[]")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamp(3)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, updatedAt], map: "chat_session_user_id_updated_at_idx")
  @@map("chat_session")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Text
  token     String   @unique(map: "refresh_token_token_key") @db.Text
  userId    String   @map("user_id") @db.Text
  expiresAt DateTime @map("expires_at") @db.Timestamp(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId], map: "refresh_token_user_id_idx")
  @@map("refresh_token")
}

model EmailOtp {
  id         String   @id @default(uuid()) @db.Text
  userId     String   @map("user_id") @db.Text
  purpose    String   @db.Text
  codeHash   String   @map("code_hash") @db.Text
  expiresAt  DateTime @map("expires_at") @db.Timestamp(3)
  lastSentAt DateTime @default(now()) @map("last_sent_at") @db.Timestamp(3)
  attempts   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, purpose], map: "email_otp_user_id_purpose_idx")
  @@map("email_otp")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Text
  userId    String    @map("user_id") @db.Text
  tokenHash String    @unique(map: "password_reset_token_token_hash_key") @map("token_hash") @db.Text
  expiresAt DateTime  @map("expires_at") @db.Timestamp(3)
  usedAt    DateTime? @map("used_at") @db.Timestamp(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, expiresAt], map: "password_reset_token_user_id_expires_at_idx")
  @@map("password_reset_token")
}

model Collection {
  id            String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String                   @db.Text
  description   String?                  @db.Text
  isPublic      Boolean                  @default(false) @map("is_public")
  ownerId       String                   @map("owner_id") @db.Text
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt     DateTime                 @updatedAt @map("updated_at") @db.Timestamp(3)
  owner         User                     @relation("CollectionOwner", fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  collaborators CollectionCollaborator[]
  flashcards    Flashcard[]

  @@index([ownerId], map: "collection_owner_id_idx")
  @@map("collection")
}

model CollectionCollaborator {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collectionId String     @map("collection_id") @db.Uuid
  userId       String     @map("user_id") @db.Text
  role         String     @default("viewer") @db.Text
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamp(3)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([collectionId, userId], map: "collection_collaborator_unique_idx")
  @@index([userId], map: "collection_collaborator_user_id_idx")
  @@map("collection_collaborator")
}

model Flashcard {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  question     String            @db.Text
  answer       String            @db.Text
  type         String            @default("simple") @db.Text
  collectionId String            @map("collection_id") @db.Uuid
  createdBy    String            @map("created_by") @db.Text
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamp(3)
  collection   Collection        @relation(fields: [collectionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  creator      User              @relation("FlashcardCreator", fields: [createdBy], references: [id], onDelete: Cascade, onUpdate: Cascade)
  reviews      FlashcardReview[]

  @@index([collectionId], map: "flashcard_collection_id_idx")
  @@map("flashcard")
}

model FlashcardReview {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  flashcardId    String    @map("flashcard_id") @db.Uuid
  userId         String    @map("user_id") @db.Text
  easeFactor     Float     @default(2.5) @map("ease_factor")
  interval       Int       @default(0)
  dueAt          DateTime  @default(now()) @map("due_at") @db.Timestamp(3)
  status         String    @default("new") @db.Text
  learningStep   Int       @default(0) @map("learning_step")
  reviewCount    Int       @default(0) @map("review_count")
  lapseCount     Int       @default(0) @map("lapse_count")
  lastReviewedAt DateTime? @map("last_reviewed_at") @db.Timestamp(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamp(3)
  flashcard      Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, flashcardId], map: "flashcard_review_user_card_idx")
  @@index([flashcardId], map: "flashcard_review_flashcard_id_idx")
  @@index([userId, dueAt], map: "flashcard_review_due_idx")
  @@index([userId, status], map: "flashcard_review_status_idx")
  @@map("flashcard_review")
}
