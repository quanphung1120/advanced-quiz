{
  "name": "@advanced-quiz/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "./dist/**"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "pnpm run db:generate && tsc -b -v",
    "db:generate": "prisma generate --config ./prisma.config.ts",
    "db:migrate": "prisma migrate dev --config ./prisma.config.ts",
    "db:deploy": "prisma migrate deploy --config ./prisma.config.ts",
    "db:push": "prisma db push --config ./prisma.config.ts",
    "db:studio": "prisma studio --config ./prisma.config.ts",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "format": "prettier --write . --ignore-unknown --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-unknown --ignore-path ../../.prettierignore"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "dotenv": "^17.3.1",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@advanced-quiz/eslint-config": "workspace:*",
    "@advanced-quiz/typescript-config": "workspace:*",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.1",
    "prisma": "^7.4.2",
    "typescript": "^5.9.2"
  }
}
