{
  "name": "@advanced-quiz/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    }
  },
  "scripts": {
    "db:generate": "bunx --bun prisma generate --config prisma.config.ts",
    "db:migrate": "bunx --bun prisma migrate dev --config prisma.config.ts",
    "db:deploy": "bunx --bun prisma migrate deploy --config prisma.config.ts",
    "db:push": "bunx --bun prisma db push --config prisma.config.ts",
    "db:studio": "bunx --bun prisma studio --config prisma.config.ts",
    "check-types": "bun run db:generate && tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prisma": "^7.4.2",
    "typescript": "^5.9.2"
  }
}
