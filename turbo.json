{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalDependencies": [".env"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/.env",
        "!**/.env.*",
        "!dist/**",
        "!.turbo/**",
        "!node_modules/**",
        "!coverage/**",
        "!**/*.tsbuildinfo"
      ],
      "outputs": ["dist/**", "src/generated/**", "!dist/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env.development.local",
        ".env.local",
        ".env.development",
        ".env",
        "!dist/**",
        "!.turbo/**",
        "!node_modules/**",
        "!coverage/**",
        "!**/*.tsbuildinfo"
      ]
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/.env",
        "!**/.env.*",
        "!dist/**",
        "!.turbo/**",
        "!node_modules/**",
        "!coverage/**",
        "!**/*.tsbuildinfo"
      ]
    },
    "format": {
      "dependsOn": ["^format"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/.env",
        "!**/.env.*",
        "!dist/**",
        "!.turbo/**",
        "!node_modules/**",
        "!coverage/**",
        "!**/*.tsbuildinfo"
      ]
    },
    "format:check": {
      "dependsOn": ["^format:check"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/.env",
        "!**/.env.*",
        "!dist/**",
        "!.turbo/**",
        "!node_modules/**",
        "!coverage/**",
        "!**/*.tsbuildinfo"
      ]
    },
    "check-types": {
      "dependsOn": ["^build", "^check-types"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!dist/**",
        "!.turbo/**",
        "!node_modules/**",
        "!coverage/**",
        "!**/*.tsbuildinfo"
      ],
      "outputs": []
    },
    "db:generate": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "db:deploy": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "db:migrate": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "db:push": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "db:studio": {
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_URL"]
    }
  }
}
